    <path
        android:fillColor="#00E5FF"
        android:pathData="M29,40h14v5h-9v6h7v5h-7v10h-5z" />
    <!-- P (the inner square is cut out) -->
    <path
        android:fillColor="#00E5FF"
        android:fillType="evenOdd"
        android:pathData="M47,40h14v16h-9v10h-5z M52,45v6h4v-6z" />
