<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon: "FPM" (FPS Monitor) in neon cyan with a small meter bar below.
  Original artwork: every letter is drawn here from plain straight-line
  shapes (no font), under the project's MIT licence. All content stays
  inside the 66dp adaptive-icon safe circle (radius 33 around 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
